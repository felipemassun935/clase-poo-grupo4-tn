@startuml Diagrama_de_Clases_Guarderia
title Sistema de Gestión para Guarderías de Mascotas — Diagrama de clases del modelo (entrega final)
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #EEF2F5
  BorderColor #4A5A66
}
skinparam stereotypeCBackgroundColor #E8F3EA
hide empty members

' ============================================================
' modelo.interfaces
' ============================================================
package "modelo.interfaces" {
  interface Facturable <<interface>> {
    + calcularTotal(): double
    + getTotalPagado(): double
    + getSaldoPendiente(): double
  }
  interface Vacunable <<interface>> {
    + getVacunasObligatorias(): List<String>
  }
  interface Notificable <<interface>> {
    + notificar(mensaje: String): void
  }
}

' ============================================================
' modelo.enums
' ============================================================
package "modelo.enums" {
  enum Especie <<enumeration>> {
    PERRO
    GATO
    CONEJO
    AVE
    - nombreVisible: String
    + getNombreVisible(): String
  }
  enum Categoria <<enumeration>> {
    ESTANDAR
    PREMIUM
    - recargoPorcentaje: double
    + aplicarRecargo(precio: double): double
  }
  enum EstadoReserva <<enumeration>> {
    PENDIENTE
    CONFIRMADA
    EN_CURSO
    FINALIZADA
    CANCELADA
    + puedePasarA(nuevo: EstadoReserva): boolean
  }
  enum TipoRegistro <<enumeration>> {
    COMIDA
    MEDICACION
    PASEO
    SERVICIO
    OBSERVACION
    INCIDENTE
    - nombreVisible: String
    - requiereAviso: boolean
    + requiereAviso(): boolean
  }
  enum TipoServicio <<enumeration>> {
    BANIO
    CORTE_PELO
    CORTE_UNIAS
    PASEO_EXTRA
    - nombreVisible: String
    - precio: double
    + seAplicaA(especie: Especie): boolean
  }
  enum TipoIndicacion <<enumeration>> {
    ALIMENTACION
    MEDICACION
    CUIDADO_ESPECIAL
    - nombreVisible: String
    - tipoRegistro: TipoRegistro
    + getTipoRegistro(): TipoRegistro
  }
  enum AccionLog <<enumeration>> {
    INGRESO
    ALTA
    MODIFICACION
    BAJA
    RESERVA
    PAGO
    CHECK_IN
    CHECK_OUT
    SERVICIO
    INDICACION
    REGISTRO
    RECHAZO
  }
}

' ============================================================
' modelo.persona
' ============================================================
package "modelo.persona" {
  abstract class Persona {
    - id: Integer
    - nombre: String
    - apellido: String
    - dni: String
    - telefono: String
    - email: String
    + getNombreCompleto(): String
    + {abstract} getRol(): String
  }
  class Cliente {
    - direccion: String
    - mascotas: List<Mascota>
    + agregarMascota(m: Mascota): void
    + quitarMascota(m: Mascota): void
    + getMascotas(): List<Mascota>
    + getRol(): String
    + notificar(mensaje: String): void
  }
  class Empleado {
    - legajo: String
    - fechaIngreso: LocalDate
    - sucursal: Sucursal
    + esEncargado(): boolean
    + getRol(): String
    + notificar(mensaje: String): void
  }
}

' ============================================================
' modelo.mascota
' ============================================================
package "modelo.mascota" {
  abstract class Mascota {
    - id: Integer
    - codigoCollar: String
    - nombre: String
    - fechaNacimiento: LocalDate
    - pesoKg: double
    - observaciones: String
    - fechaUltimoControl: LocalDate
    - cliente: Cliente
    - vacunas: List<Vacuna>
    + {abstract} getEspecie(): Especie
    + {abstract} validarIngreso(fecha: LocalDate): List<String>
    + {static} generarCodigoCollar(id: Integer): String
    + agregarVacuna(v: Vacuna): void
    + tieneVacunaVigente(nombre: String, fecha: LocalDate): boolean
    # tieneControlVigente(fecha: LocalDate, dias: int): boolean
    + getEdadEnMeses(): int
  }
  class "Mascota.Vacuna" as Vacuna <<clase anidada static>> {
    - nombre: String
    - fechaAplicacion: LocalDate
    - fechaVencimiento: LocalDate
    + estaVigente(fecha: LocalDate): boolean
  }
  class Perro {
    - raza: String
    - castrado: boolean
    + getEspecie(): Especie
    + validarIngreso(fecha: LocalDate): List<String>
    + getVacunasObligatorias(): List<String>
  }
  class Gato {
    - raza: String
    - castrado: boolean
    + getEspecie(): Especie
    + validarIngreso(fecha: LocalDate): List<String>
    + getVacunasObligatorias(): List<String>
  }
  class Conejo {
    - raza: String
    + getEspecie(): Especie
    + validarIngreso(fecha: LocalDate): List<String>
  }
  class Ave {
    - tipoAve: String
    + getEspecie(): Especie
    + validarIngreso(fecha: LocalDate): List<String>
  }
}

' ============================================================
' modelo.sucursal
' ============================================================
package "modelo.sucursal" {
  class Sucursal {
    - id: Integer
    - nombre: String
    - direccion: String
    - telefono: String
    - encargado: Empleado
    - alojamientos: List<Alojamiento>
    - empleados: List<Empleado>
    + agregarAlojamiento(a: Alojamiento): void
    + agregarEmpleado(e: Empleado): void
    + getAlojamientosDe(especie: Especie): List<Alojamiento>
    + getCapacidadPorEspecie(): Map<Especie, Integer>
  }
  class Alojamiento {
    - id: Integer
    - codigo: String
    - especie: Especie
    - categoria: Categoria
    - precioBaseNoche: double
    - activo: boolean
    - sucursal: Sucursal
    + admite(m: Mascota): boolean
    + getPrecioNoche(): double
  }
}

' ============================================================
' modelo.reserva
' ============================================================
package "modelo.reserva" {
  class Reserva {
    - id: Integer
    - mascota: Mascota
    - alojamiento: Alojamiento
    - fechaDesde: LocalDate
    - fechaHasta: LocalDate
    - estado: EstadoReserva
    - pagos: List<Pago>
    - registros: List<RegistroDiario>
    - servicios: List<ServicioContratado>
    - indicaciones: List<Indicacion>
    + getCantidadNoches(): long
    + getTotalAlojamiento(): double
    + getTotalServicios(): double
    + calcularTotal(): double
    + getTotalPagado(): double
    + getSaldoPendiente(): double
    + confirmar(): void
    + realizarCheckIn(fecha: LocalDate): void
    + realizarCheckOut(): void
    + cancelar(): void
    - cambiarEstado(nuevo: EstadoReserva): void
    + registrarPago(monto: double, medio: String): Pago
    + agregarRegistro(tipo, descripcion, empleado): RegistroDiario
    + agregarRegistro(tipo, descripcion, empleado, indicacion: Indicacion): RegistroDiario
    + contratarServicio(id: Integer, tipo: TipoServicio): ServicioContratado
    + realizarServicio(s: ServicioContratado, empleado: Empleado): RegistroDiario
    + quitarServicio(s: ServicioContratado): void
    + tieneServiciosPendientes(): boolean
    + agregarIndicacion(id, tipo: TipoIndicacion, descripcion, horario): Indicacion
    + quitarIndicacion(i: Indicacion): void
    + getCantidadCumplimientos(i: Indicacion): int
    + getUltimoCumplimiento(i: Indicacion): RegistroDiario
    + seSuperponeCon(desde: LocalDate, hasta: LocalDate): boolean
  }
  class "Reserva.Pago" as Pago <<clase anidada static>> {
    - fecha: LocalDate
    - monto: double
    - medio: String
  }
  class "Reserva.RegistroDiario" as RegistroDiario <<clase interna>> {
    - fechaHora: LocalDateTime
    - tipo: TipoRegistro
    - descripcion: String
    - empleado: Empleado
    - indicacion: Indicacion
    + getResumen(): String
    + notificarSiCorresponde(): void
  }
  class ServicioContratado {
    - id: Integer
    - tipo: TipoServicio
    - precio: double
    - fechaSolicitud: LocalDate
    - realizado: boolean
    - fechaHoraRealizado: LocalDateTime
    - realizadoPor: Empleado
    + marcarRealizado(empleado: Empleado, fechaHora: LocalDateTime): void
    + getEstadoTexto(): String
  }
  class Indicacion {
    - id: Integer
    - tipo: TipoIndicacion
    - descripcion: String
    - horario: String
  }
}

' ============================================================
' modelo.log
' ============================================================
package "modelo.log" {
  class EntradaLog {
    - fechaHora: LocalDateTime
    - usuario: String
    - accion: AccionLog
    - detalle: String
  }
}

' ============================================================
' Herencias
' ============================================================
Persona <|-- Cliente
Persona <|-- Empleado
Mascota <|-- Perro
Mascota <|-- Gato
Mascota <|-- Conejo
Mascota <|-- Ave

' ============================================================
' Realizaciones de interfaces
' ============================================================
Facturable <|.. Reserva
Vacunable <|.. Perro
Vacunable <|.. Gato
Notificable <|.. Cliente
Notificable <|.. Empleado

' ============================================================
' Asociación, agregación, composición y dependencia
' ============================================================
Cliente "1" o-- "1..*" Mascota
Mascota "1" *-- "0..*" Vacuna
Sucursal "1" *-- "0..*" Alojamiento
Sucursal "1" o-- "0..*" Empleado
Sucursal "*" --> "0..1" Empleado : encargado
Reserva "*" --> "1" Mascota
Reserva "*" --> "1" Alojamiento
Reserva "1" *-- "0..*" Pago
Reserva "1" *-- "0..*" RegistroDiario
RegistroDiario "*" --> "1" Empleado
RegistroDiario ..> Notificable : <<usa>>
Reserva "1" *-- "0..*" ServicioContratado
Reserva "1" *-- "0..*" Indicacion
RegistroDiario "*" --> "0..1" Indicacion : cumple
ServicioContratado "*" --> "0..1" Empleado : realizadoPor

@enduml
