@startuml Diagrama_de_Clases_Guarderia
title Sistema de Gestión para Guarderías de Mascotas — Diagrama de clases del modelo
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #EEF2F5
  BorderColor #4A5A66
}
skinparam stereotypeCBackgroundColor #E8F3EA
hide empty members

' ============================================================
' modelo.interfaces
' ============================================================
package "modelo.interfaces" {
  interface Facturable <<interface>> {
    + calcularTotal(): double
    + getTotalPagado(): double
    + getSaldoPendiente(): double
  }
  interface Vacunable <<interface>> {
    + getVacunasObligatorias(): List<String>
  }
  interface Notificable <<interface>> {
    + notificar(mensaje: String): void
  }
}

' ============================================================
' modelo.enums
' ============================================================
package "modelo.enums" {
  enum Especie <<enumeration>> {
    PERRO
    GATO
    CONEJO
    AVE
    - nombreVisible: String
    + getNombreVisible(): String
  }
  enum Categoria <<enumeration>> {
    ESTANDAR
    PREMIUM
    - recargoPorcentaje: double
    + aplicarRecargo(precio: double): double
  }
  enum EstadoReserva <<enumeration>> {
    PENDIENTE
    CONFIRMADA
    EN_CURSO
    FINALIZADA
    CANCELADA
    + puedePasarA(nuevo: EstadoReserva): boolean
  }
  enum TipoRegistro <<enumeration>> {
    COMIDA
    MEDICACION
    INCIDENTE
    - requiereAviso: boolean
    + requiereAviso(): boolean
  }
}

' ============================================================
' modelo.persona
' ============================================================
package "modelo.persona" {
  abstract class Persona {
    - id: Integer
    - nombre: String
    - apellido: String
    - dni: String
    - telefono: String
    - email: String
    + getNombreCompleto(): String
    + {abstract} getRol(): String
  }
  class Cliente {
    - direccion: String
    - mascotas: List<Mascota>
    + agregarMascota(m: Mascota): void
    + quitarMascota(m: Mascota): void
    + getMascotas(): List<Mascota>
    + getRol(): String
    + notificar(mensaje: String): void
  }
  class Empleado {
    - legajo: String
    - fechaIngreso: LocalDate
    - sucursal: Sucursal
    + getRol(): String
    + notificar(mensaje: String): void
  }
}

' ============================================================
' modelo.mascota
' ============================================================
package "modelo.mascota" {
  abstract class Mascota {
    - id: Integer
    - nombre: String
    - fechaNacimiento: LocalDate
    - pesoKg: double
    - observaciones: String
    - fechaUltimoControl: LocalDate
    - cliente: Cliente
    - vacunas: List<Vacuna>
    + {abstract} getEspecie(): Especie
    + {abstract} validarIngreso(fecha: LocalDate): List<String>
    + agregarVacuna(v: Vacuna): void
    + tieneVacunaVigente(nombre: String, fecha: LocalDate): boolean
    # tieneControlVigente(fecha: LocalDate, dias: int): boolean
    + getEdadEnMeses(): int
  }
  class "Mascota.Vacuna" as Vacuna <<clase anidada static>> {
    - nombre: String
    - fechaAplicacion: LocalDate
    - fechaVencimiento: LocalDate
    + estaVigente(fecha: LocalDate): boolean
  }
  class Perro {
    - raza: String
    - castrado: boolean
    + getEspecie(): Especie
    + validarIngreso(fecha: LocalDate): List<String>
    + getVacunasObligatorias(): List<String>
  }
  class Gato {
    - raza: String
    - castrado: boolean
    + getEspecie(): Especie
    + validarIngreso(fecha: LocalDate): List<String>
    + getVacunasObligatorias(): List<String>
  }
  class Conejo {
    - raza: String
    + getEspecie(): Especie
    + validarIngreso(fecha: LocalDate): List<String>
  }
  class Ave {
    - tipoAve: String
    + getEspecie(): Especie
    + validarIngreso(fecha: LocalDate): List<String>
  }
}

' ============================================================
' modelo.sucursal
' ============================================================
package "modelo.sucursal" {
  class Sucursal {
    - id: Integer
    - nombre: String
    - direccion: String
    - telefono: String
    - encargado: Empleado
    - alojamientos: List<Alojamiento>
    - empleados: List<Empleado>
    + agregarAlojamiento(a: Alojamiento): void
    + agregarEmpleado(e: Empleado): void
    + getAlojamientosDe(especie: Especie): List<Alojamiento>
    + getCapacidadPorEspecie(): Map<Especie, Integer>
  }
  class Alojamiento {
    - id: Integer
    - codigo: String
    - especie: Especie
    - categoria: Categoria
    - precioBaseNoche: double
    - activo: boolean
    - sucursal: Sucursal
    + admite(m: Mascota): boolean
    + getPrecioNoche(): double
  }
}

' ============================================================
' modelo.reserva
' ============================================================
package "modelo.reserva" {
  class Reserva {
    - id: Integer
    - mascota: Mascota
    - alojamiento: Alojamiento
    - fechaDesde: LocalDate
    - fechaHasta: LocalDate
    - estado: EstadoReserva
    - pagos: List<Pago>
    - registros: List<RegistroDiario>
    + getCantidadNoches(): long
    + calcularTotal(): double
    + getTotalPagado(): double
    + getSaldoPendiente(): double
    + confirmar(): void
    + realizarCheckIn(fecha: LocalDate): void
    + realizarCheckOut(): void
    + cancelar(): void
    - cambiarEstado(nuevo: EstadoReserva): void
    + registrarPago(monto: double, medio: String): void
    + agregarRegistro(tipo: TipoRegistro, descripcion: String, empleado: Empleado): void
    + seSuperponeCon(desde: LocalDate, hasta: LocalDate): boolean
  }
  class "Reserva.Pago" as Pago <<clase anidada static>> {
    - fecha: LocalDate
    - monto: double
    - medio: String
  }
  class "Reserva.RegistroDiario" as RegistroDiario <<clase interna>> {
    - fechaHora: LocalDateTime
    - tipo: TipoRegistro
    - descripcion: String
    - empleado: Empleado
    + getResumen(): String
    + notificarSiCorresponde(): void
  }
}

' ============================================================
' Herencias
' ============================================================
Persona <|-- Cliente
Persona <|-- Empleado
Mascota <|-- Perro
Mascota <|-- Gato
Mascota <|-- Conejo
Mascota <|-- Ave

' ============================================================
' Realizaciones de interfaces
' ============================================================
Facturable <|.. Reserva
Vacunable <|.. Perro
Vacunable <|.. Gato
Notificable <|.. Cliente
Notificable <|.. Empleado

' ============================================================
' Asociación, agregación, composición y dependencia
' ============================================================
Cliente "1" o-- "1..*" Mascota
Mascota "1" *-- "0..*" Vacuna
Sucursal "1" *-- "0..*" Alojamiento
Sucursal "1" o-- "0..*" Empleado
Sucursal "*" --> "0..1" Empleado : encargado
Reserva "*" --> "1" Mascota
Reserva "*" --> "1" Alojamiento
Reserva "1" *-- "0..*" Pago
Reserva "1" *-- "0..*" RegistroDiario
RegistroDiario "*" --> "1" Empleado
RegistroDiario ..> Notificable : <<usa>>

@enduml
