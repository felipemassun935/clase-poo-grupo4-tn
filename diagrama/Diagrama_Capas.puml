@startuml Diagrama_Capas
title Sistema de Gestión para Guarderías de Mascotas — Capas y cómo usan al modelo
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #EEF2F5
  BorderColor #4A5A66
}
hide empty members

package "app" {
  class Main {
    + {static} main(args: String[]): void
  }
}

package "vista" {
  class MenuPrincipal
  class "VentanaClientes\nVentanaMascotas\nVentanaEmpleados\nVentanaAlojamientos" as ABM <<4 ABM>>
  class "VentanaReservas\nVentanaEstadias" as Negocio <<2 pantallas de negocio>>
  class DialogoVacunas <<JDialog modal>>
  class DialogoDetalleReserva <<JDialog modal>>
  class VentanaLog <<SwingWorker>>
  class Validaciones {
    + {static} texto(valor: String, campo: String): String
    + {static} numero(valor: String, campo: String): double
    + {static} entero(valor: String, campo: String): int
    + {static} parsearFecha(valor: String, campo: String): LocalDate
    + {static} formatearFecha(fecha: LocalDate): String
  }
}

package "controlador" {
  class SistemaGuarderia <<Controlador>> <<Singleton>> {
    - {static} instancia: SistemaGuarderia
    - sucursales: List<Sucursal>
    - empleados: List<Empleado>
    - clientes: List<Cliente>
    - mascotas: List<Mascota>
    - reservas: List<Reserva>
    - SistemaGuarderia()
    + {static} getInstancia(): SistemaGuarderia
    + altaCliente(...) / altaMascota(...) / altaEmpleado(...) / altaAlojamiento(...)
    + buscarDisponibles(s, m, desde, hasta): List<Alojamiento>
    + reservar(m, a, desde, hasta): Reserva
    + confirmar(r) / cancelar(r) / checkIn(r) / checkOut(r)
    - repositorio: Repositorio
    - operador: Empleado
    + iniciarSesion(legajo: String): Empleado
    + buscarPorCollar(codigo: String): Mascota
    + agregarRegistro(r, tipo, descripcion, empleado, indicacion): void
    + registrarPago(r, monto, medio): void
    + contratarServicio(r, tipo) / realizarServicio(r, s, empleado) / quitarServicio(r, s)
    + agregarIndicacion(r, tipo, descripcion, horario) / quitarIndicacion(r, i)
    + getLogs(): List<EntradaLog>
    - registrarLog(accion: AccionLog, detalle: String): void
    + getOcupacion(s: Sucursal): Map<Especie, String>
  }
}

package "persistencia" {
  class ConexionBD {
    - url: String
    - usuario: String
    - clave: String
    + conectar(): Connection
  }
  class Repositorio <<Fabricación pura>> {
    + cargar(sucursales, empleados, clientes, mascotas, reservas): void
    + insertarX(...) / actualizarX(...) / borrarX(...)
    + insertarLog(log: EntradaLog): void
    + listarLogs(): List<EntradaLog>
    - ejecutar(sql: String): void
  }
  Repositorio --> ConexionBD
}

package "excepciones" {
  class IngresoRechazadoException {
    - problemas: List<String>
  }
  class DatoInvalidoException
  class ErrorBaseDeDatosException <<unchecked>>
  IngresoRechazadoException -[hidden]- DatoInvalidoException
}

package "modelo" <<Rectangle>> {
  class "persona · mascota · sucursal\nreserva · log · interfaces · enums" as Modelo <<ver Diagrama_de_Clases>>
}

class "SQL Server\nGuarderiaMascotas\n(bd/*.sql)" as BD <<base de datos>>
note "conexion.txt\n(url, usuario, clave)" as Archivo

Main ..> MenuPrincipal : abre
MenuPrincipal ..> ABM : abre
MenuPrincipal ..> Negocio : abre
ABM ..> DialogoVacunas : abre
Negocio ..> DialogoDetalleReserva : abre
MenuPrincipal ..> VentanaLog : abre
ABM ..> Validaciones
Negocio ..> Validaciones

ABM --> SistemaGuarderia : getInstancia()
Negocio --> SistemaGuarderia : getInstancia()
ABM ..> Modelo : muestra
Negocio ..> Modelo : muestra

SistemaGuarderia --> Modelo : guarda las listas\ny delega
SistemaGuarderia --> Repositorio : guarda cada cambio\ny el log
Repositorio ..> Modelo : arma los objetos\ny sus referencias
ConexionBD .. Archivo
Repositorio --> BD : JDBC (Statement,\nResultSet)
Repositorio ..> ErrorBaseDeDatosException : lanza
Main ..> ErrorBaseDeDatosException : atrapa

Modelo ..> IngresoRechazadoException : Reserva.realizarCheckIn()\nla lanza
SistemaGuarderia ..> DatoInvalidoException : lanza
Validaciones ..> DatoInvalidoException : lanza
Negocio ..> IngresoRechazadoException : atrapa

@enduml
